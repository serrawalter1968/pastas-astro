---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | Pasta Arte</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <ViewTransitions />
</head>
<body>
  <header>
    <nav>
      <a href="/" class="logo">🍝 Pasta <span>Arte</span></a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/productos">Productos</a></li>
        <li><a href="/nosotros">Nosotros</a></li>
        <li><a href="/contacto">Contacto</a></li>
      </ul>
      <button class="carrito-btn" onclick="toggleCarrito()" aria-label="Abrir carrito">
        <svg viewBox="0 0 24 24" stroke-width="1.5">
          <path d="M6 6h15l-1.5 9h-12z" />
          <circle cx="9" cy="20" r="1" />
          <circle cx="18" cy="20" r="1" />
          <path d="M6 6L5 3H2" />
        </svg>
        <span id="carrito-contador" class="carrito-contador" style="display: none;">0</span>
      </button>
    </nav>
  </header>

  <div id="carrito-overlay" class="carrito-overlay" onclick="cerrarCarrito()"></div>
  <div id="carrito-panel" class="carrito-panel">
    <div class="carrito-header">
      <h2>Tu Carrito</h2>
      <button class="carrito-cerrar" onclick="cerrarCarrito()">✕</button>
    </div>
    <div id="carrito-items" class="carrito-items">
      <div id="carrito-vacio" class="carrito-vacio">
        <span>🛒</span>
        <p>Tu carrito está vacío</p>
        <p style="font-size: 0.9rem;">Agrega algunas pastas deliciosas</p>
      </div>
    </div>
    <div class="carrito-footer">
      <div class="carrito-total">
        <span>Total:</span>
        <strong id="carrito-total">$0</strong>
      </div>
      <button class="carrito-vaciar" onclick="vaciarCarrito()">Vaciar Carrito</button>
      <button class="carrito-checkout">Finalizar Compra</button>
    </div>
  </div>

  <slot />

  <footer>
    <div class="container">
      <div class="footer-logo">🍝 Pasta Arte</div>
      <p>Pastas artesanales elaboradas con amor y tradición italiana</p>
      <p style="margin-top: 1rem; font-size: 0.9rem;">© 2026 Pasta Arte. Todos los derechos reservados.</p>
    </div>
  </footer>
  <script is:inline src="/scripts/carrito.js"></script>
</body>
</html>